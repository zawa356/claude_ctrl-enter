{
  "manifest_version": 3,
  "name": "Claude Ctrl+Enter",
  "version": "0.4.2",
  "description": "Enter for newline, Ctrl+Enter to send in Claude Desktop, with Japanese IME protection and configurable keys.",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "keys.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "settings-ui.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage"
  ]
}
